<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Colección {{coleccion.nombre}}</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        header {
            text-align: center;
            margin-bottom: 30px;
        }

        header h1 {
            font-size: 2.2rem;
            color: #2c3e50;
        }

        section {
            background-color: #fff;
            padding: 20px;
            max-width: 800px;
            margin: 0 auto 30px auto;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        section p {
            margin-bottom: 10px;
            font-size: 1rem;
        }

        section h2 {
            margin-top: 20px;
            margin-bottom: 10px;
            color: #34495e;
        }

        ul {
            list-style-type: disc;
            padding-left: 20px;
        }

        li {
            margin-bottom: 8px;
        }

        footer {
            text-align: center;
            margin-top: 20px;
        }

        footer a {
            text-decoration: none;
            color: #2980b9;
            font-weight: bold;
            transition: color 0.3s;
        }

        footer a:hover {
            color: #1c5980;
        }

        #map {
            height: 400px;
            margin: 20px auto;
            max-width: 800px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .filtros-container {
            background: #ffffff;
            padding: 1.5rem 2rem;
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
            margin: 2rem auto;
            max-width: 900px;
            transition: all 0.2s ease;
        }

        .filtros-container:hover {
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        }

        .filtros-container h2 {
            margin-bottom: 1.5rem;
            font-size: 1.6rem;
            color: #333;
            text-align: center;
        }

        .filtros-form {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.2rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group label {
            margin-bottom: 0.4rem;
            font-weight: 600;
            color: #555;
        }

        .filtros-form input,
        .filtros-form select {
            padding: 0.5rem 0.8rem;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 0.95rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .filtros-form input:focus,
        .filtros-form select:focus {
            border-color: #0077ff;
            box-shadow: 0 0 4px rgba(0, 119, 255, 0.3);
            outline: none;
        }

        .form-actions {
            grid-column: 1 / -1;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 1rem;
            margin-top: 1rem;
        }

        .form-actions button {
            background-color: #0077ff;
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 0.6rem 1.4rem;
            font-size: 1rem;
            cursor: pointer;
            transition: background-color 0.2s ease, transform 0.1s ease;
        }

        .form-actions button:hover {
            background-color: #005fcc;
            transform: translateY(-1px);
        }

        .btn-secondary {
            background-color: #e0e0e0;
            color: #333;
            text-decoration: none;
            border-radius: 8px;
            padding: 0.6rem 1.4rem;
            font-size: 1rem;
            transition: background-color 0.2s ease, transform 0.1s ease;
        }

        .btn-secondary:hover {
            background-color: #cfcfcf;
            transform: translateY(-1px);
        }

        @media (max-width: 600px) {
            .filtros-container {
                padding: 1rem;
            }
            .filtros-form {
                grid-template-columns: 1fr;
            }
            .form-actions {
                flex-direction: column;
            }
        }

        .as-link {
            background: none;
            border: none;
            padding: 0;
            margin: 0;
            color: #007BFF;
            text-decoration: underline;
            cursor: pointer;
            font-size: 0.9rem;
        }
        .as-link:hover {
            color: #0056b3;
        }
    </style>

    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
</head>
<body>

<header>
    <h1>{{coleccion.nombre}}</h1>
</header>

<div class="filtros-container">
    <h2>Filtrar Hechos</h2>

    <form method="get" action="/colecciones/{{coleccion.id}}" class="filtros-form">
        <div class="form-group">
            <label for="campoTexto">Buscar por:</label>
            <select name="campoTexto" id="campoTexto">
                <option value="titulo">Título</option>
                <option value="descripcion">Descripción</option>
            </select>
        </div>

        <div class="form-group">
            <label for="textoFiltro">Texto contiene:</label>
            <input type="text" id="textoFiltro" name="textoFiltro" placeholder="Palabra clave...">
        </div>

        <div class="form-group">
            <label for="fechaDesde">Fecha desde:</label>
            <input type="datetime-local" id="fechaDesde" name="fechaDesde">
        </div>

        <div class="form-group">
            <label for="fechaHasta">Fecha hasta:</label>
            <input type="datetime-local" id="fechaHasta" name="fechaHasta">
        </div>

        <div class="form-actions">
            <button type="submit">Aplicar filtros</button>
        </div>
    </form>
</div>

<section>
    <p><strong>Titulo:</strong> {{coleccion.titulo}}</p>
    <p><strong>Descripción:</strong> {{coleccion.descripcion}}</p>
    <p><strong>Fecha de creación:</strong> {{coleccion.fechaDeCreacion}}</p>
    <div id="map"></div>
</section>

<footer>
    <a href="/colecciones">← Volver a todas las colecciones</a>
</footer>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script>
    const hechos = {{{hechosJson}}};
    const coleccionId = {{coleccion.id}};

    const map = L.map('map').setView([-34.6037, -58.3816], 5);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    if (hechos && hechos.length > 0) {
        const coords = [];

        hechos.forEach(h => {
            if (h.ubicacion && h.ubicacion.latitud && h.ubicacion.longitud) {
                const hechoJson = encodeURIComponent(JSON.stringify(h));

                const popupHtml = `
          <b>${h.titulo}</b><br>
          ${h.descripcion}<br>
          (${h.ubicacion.latitud}, ${h.ubicacion.longitud})<br>
          <a href="/colecciones/${coleccionId}/hechos?id=${h.id}&hecho=${hechoJson}">
            Ver detalle
          </a>
        `;

                L.marker([h.ubicacion.latitud, h.ubicacion.longitud])
                        .addTo(map)
                        .bindPopup(popupHtml);

                coords.push([h.ubicacion.latitud, h.ubicacion.longitud]);
            }
        });

        if (coords.length > 0) {
            const bounds = L.latLngBounds(coords);
            map.fitBounds(bounds);
        }
    } else {
        console.log("No hay hechos con coordenadas");
    }
</script>
</body>
</html>
