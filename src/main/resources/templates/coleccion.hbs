<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Colección {{coleccion.nombre}}</title>

    <style>
        /* Reset básico */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f5f5f5;
            color: #333;
            line-height: 1.6;
            padding: 20px;
        }

        header {
            text-align: center;
            margin-bottom: 30px;
        }

        header h1 {
            font-size: 2.2rem;
            color: #2c3e50;
        }

        section {
            background-color: #fff;
            padding: 20px;
            max-width: 800px;
            margin: 0 auto 30px auto;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        section p {
            margin-bottom: 10px;
            font-size: 1rem;
        }

        section h2 {
            margin-top: 20px;
            margin-bottom: 10px;
            color: #34495e;
        }

        ul {
            list-style-type: disc;
            padding-left: 20px;
        }

        li {
            margin-bottom: 8px;
        }

        footer {
            text-align: center;
            margin-top: 20px;
        }

        footer a {
            text-decoration: none;
            color: #2980b9;
            font-weight: bold;
            transition: color 0.3s;
        }

        footer a:hover {
            color: #1c5980;
        }

        /* Contenedor del mapa */
        #map {
            height: 400px;
            margin: 20px auto;
            max-width: 800px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
    </style>

    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
</head>
<body>

<header>
    <h1>{{coleccion.nombre}}</h1>
</header>

<section>
    <p><strong>Titulo:</strong> {{coleccion.titulo}}</p>
    <p><strong>Descripción:</strong> {{coleccion.descripcion}}</p>
    <p><strong>Fecha de creación:</strong> {{coleccion.fechaDeCreacion}}</p>

    <!-- Contenedor del mapa -->
    <div id="map"></div>
</section>

<footer>
    <a href="/colecciones">← Volver a todas las colecciones</a>
</footer>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script>
    // Los datos vienen del backend como un JSON string
    const hechos = {{{hechosJson}}}; // triple llave para no escapar comillas

    // Crear el mapa centrado en Buenos Aires (ajustá el zoom si tus puntos están lejos)
    const map = L.map('map').setView([-34.6037, -58.3816], 5);

    // Capa base (OpenStreetMap)
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    // Añadir los marcadores
    hechos.forEach(h => {
        if(h.ubicacion && h.ubicacion.latitud && h.ubicacion.longitud) {
            L.marker([h.ubicacion.latitud, h.ubicacion.longitud])
                    .addTo(map)
                    .bindPopup(`
                    <b>${h.titulo}</b><br>
                    ${h.descripcion}<br>
                    (${h.ubicacion.latitud}, ${h.ubicacion.longitud})
                `);
        }
    });
</script>

</body>
</html>
