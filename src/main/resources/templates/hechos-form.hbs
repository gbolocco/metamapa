<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>{{title}}</title>
    <link rel="stylesheet" href="/static/css/style_form.css">
</head>
<div class="form-container">
    <h1>Solicitar Carga de Hecho</h1>

    <form method="post" action="/hechos">
        <div class="form-group">
            <label for="titulo">Título:</label>
            <input type="text" id="titulo" name="titulo" required>
        </div>

        <div class="form-group">
            <label for="descripcion">Descripción:</label>
            <textarea id="descripcion" name="descripcion" rows="3" required></textarea>
        </div>

        <div class="form-group">
            <label for="lat">Latitud:</label>
            <input type="number" step="0.0001" id="lat" name="lat" required>
        </div>

        <div class="form-group">
            <label for="lon">Longitud:</label>
            <input type="number" step="0.0001" id="lon" name="lon" required>
        </div>

        <div class="form-group">
            <label for="categoria">Categoria:</label>
            <input type="text" id="categoria" name="categoria" required>
        </div>

        <div class="form-group">
            <label for="fecheOcurrencia">Fecha de ocurrencia:</label>
            <input type="datetime-local"  name="fechaOcurrencia" required>
        </div>

        <div class="form-group">
            <label for="foto">Foto:</label>
              <input type="text" id="foto" name="foto" />
        </div>

        <div class="form-group">
            <label for="video">Video:</label>
              <input type="text" id="video" name="video" />
        </div>


        <div class="form-actions">
            <a href="/" class="btn-link">Volver</a>
            <button type="submit" class="btn-submit">Generar Solicitud de Carga</button>
        </div>

    </form>
</div>

<style>
.form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
}

.btn-link {
    color: #007bff;
    text-decoration: none;
    font-size: 16px;
}

.btn-link:hover {
    text-decoration: underline;
    color: #0056b3;
}

.btn-submit {
    background-color: #75501d;
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 6px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.3s;
}

.btn-submit:hover {
    background-color: #4b2f0c;
    transform: scale(1.03);
}
</style>
