<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/static/css/style_hecho.css">
    <style>
        /* ✅ Ajuste dinámico de título */
        .hecho-datos h1 {
            font-size: clamp(1.2rem, 2vw + 1rem, 2.8rem);
            word-wrap: break-word;
            overflow-wrap: break-word;
            text-align: center;
            margin-bottom: 1rem;
            line-height: 1.2;
        }

        /* ✅ Ajuste visual cuando no hay multimedia */
        .hecho-sin-multimedia .hecho-imagen {
            display: none;
        }

        .hecho-sin-multimedia .hecho-datos {
            flex: 1;
            width: 100%;
            text-align: center;
        }



        .hecho-imagen {
            flex: 1;
            background-color: #d4b27f;
            display: flex;
            justify-content: center;
            align-items: center;
            border-right: 1px solid #000;
        }

        .hecho-datos {
            flex: 2;
            padding: 2rem;
            color: white;
            background-color: rgba(108, 71, 27, 0.85);
        }

        .hecho-acciones {
            margin-top: 1.5rem;
        }

        .boton-solicitar {
            background-color: #b30000;
            color: white;
            border: none;
            padding: 0.6rem 1.2rem;
            border-radius: 5px;
            cursor: pointer;
        }

        .boton-solicitar:hover {
            background-color: #800000;
        }

        /* ********************************************************** */
        /* CSS LOCAL PARA EVITAR CONFLICTO CON ESTILOS INYECTADOS */
        /* ********************************************************** */


        /* 3. Flechas debajo */
        .hecho-flechas {
            /* Quitamos el posicionamiento absoluto */
            position: static;
            width: 100%;
            padding: 10px 0;
            display: flex;
            justify-content: center; /* Centrar las flechas */
            gap: 20px;
            /* Fondo para que parezca parte del marco */
            background: rgba(108, 71, 27, 0.85);
            border-radius: 0 0 8px 8px; /* Bordes redondeados solo abajo */
            box-shadow: 0 5px 5px rgba(0, 0, 0, 0.1) inset; /* Sombra sutil */
        }

        .hecho-flechas .flecha {
            /* Estilos de las flechas */
            text-decoration: none;
            font-size: 1.5rem;
            color: #fff;
            background-color: rgba(0, 0, 0, 0.2);
            border-radius: 4px;
            width: 30px;
            height: 30px;
            line-height: 30px;
            text-align: center;
            cursor: pointer;
            transition: opacity 0.3s, background-color 0.3s;
            /* Aseguramos que los estilos anteriores de margen negativo NO se apliquen */
            margin: 0 !important;
        }

        .hecho-flechas .flecha:hover {
            background-color: rgba(0, 0, 0, 0.4);
        }

        /* Si no hay multimedia, ocultamos las flechas */
        .hecho-sin-multimedia .hecho-flechas {
            display: none;
        }

        /* Corregimos el estilo de la línea divisoria del lado derecho */
        .hecho-datos::after {
            content: none !important; /* Anulamos el pseudo-elemento absoluto que causa problemas */
        }


    </style>
</head>
<body>

<main class="hecho-main">
    <div id="hechoContenedor" class="hecho-contenedor">

        <div class="hecho-contenido-superior">
            <div class="hecho-imagen" id="contenedorMultimedia"></div>

            <div class="hecho-datos">
                <h1>{{hecho.titulo}}</h1>

                <p><strong>Categoría:</strong> {{hecho.categoria}}</p>
                <p><strong>Descripción:</strong> {{hecho.descripcion}}</p>
                <p><strong>Estado:</strong> {{hecho.estadoHecho}}</p>
                <p><strong>Fecha del hecho:</strong> {{hecho.fechaAcontecimiento}}</p>
                <p><strong>Origen:</strong> {{hecho.origenHecho}}</p>

                <div class="hecho-acciones">
                    <button type="button" class="boton-solicitar">Solicitar Eliminación</button>
                </div>
            </div>
        </div>
        <div class="hecho-flechas">
            <a href="#" id="flechaAnterior" class="flecha">⬅</a>
            <a href="#" id="flechaSiguiente" class="flecha">➡</a>
        </div>


    </div>
</main>

<script>
    const urlsMultimedia = [
        {{#each hecho.contenidoMultimedia}}
            "{{this.urlArchivo}}"{{#unless @last}},{{/unless}}
        {{/each}}
    ];

    const tiposMultimedia = [
        {{#each hecho.contenidoMultimedia}}
            "{{this.tipoContenido}}"{{#unless @last}},{{/unless}}
        {{/each}}
    ];

    const contenedor = document.getElementById('contenedorMultimedia');
    const contenedorPrincipal = document.getElementById('hechoContenedor');
    const flechaAnterior = document.getElementById('flechaAnterior');
    const flechaSiguiente = document.getElementById('flechaSiguiente');
    let indiceActual = 0;

    function actualizarFlechas() {
        flechaAnterior.style.opacity = (indiceActual === 0) ? 0.5 : 1;
        flechaSiguiente.style.opacity = (indiceActual === urlsMultimedia.length - 1) ? 0.5 : 1;
    }

    function renderizarContenido() {
        const tipo = tiposMultimedia[indiceActual];
        const url = urlsMultimedia[indiceActual];
        console.log("renderizando contenido")

        if(tipo === "VIDEO") {
            contenedor.innerHTML = `
                <video id="imagenPrincipal" class="imagen-principal" controls preload="metadata">
                    <source src="${url}" type="video/mp4">
                    Tu navegador no soporta videos.
                </video>
            `;
        } else {
            contenedor.innerHTML = `
                <img id="imagenPrincipal" src="${url}" class="imagen-principal">
            `;
        }

        actualizarFlechas();
    }

    // Navegación
    flechaSiguiente.addEventListener('click', e => {
        e.preventDefault();
        if(indiceActual < urlsMultimedia.length - 1){
            indiceActual++;
            renderizarContenido();
        }
    });

    flechaAnterior.addEventListener('click', e => {
        e.preventDefault();
        if(indiceActual > 0){
            indiceActual--;
            renderizarContenido();
        }
    });

    // Inicialización
    if(urlsMultimedia.length > 0){
        renderizarContenido();
        if(urlsMultimedia.length === 1){
            flechaAnterior.style.display = 'none';
            flechaSiguiente.style.display = 'none';
        }
        // No es necesario un "else" para mostrar, ya que se asume visible por defecto.
    } else {
        contenedorPrincipal.classList.add("hecho-sin-multimedia");
        flechaAnterior.style.display = 'none';
        flechaSiguiente.style.display = 'none';
    }
</script>

</body>
</html>