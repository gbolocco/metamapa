<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/static/css/style_hecho.css">
    <style>
        /* ✅ Ajuste dinámico de título */
        .hecho-datos h1 {
            font-size: clamp(1.2rem, 2vw + 1rem, 2.8rem);
            word-wrap: break-word;
            overflow-wrap: break-word;
            text-align: center;
            margin-bottom: 1rem;
            line-height: 1.2;
        }

        /* ✅ Ajuste visual cuando no hay multimedia */
        .hecho-sin-multimedia .hecho-imagen {
            display: none;
        }

        .hecho-sin-multimedia .hecho-datos {
            flex: 1;
            width: 100%;
            text-align: center;
        }



        .hecho-imagen {
            flex: 1;
            background-color: #d4b27f;
            display: flex;
            justify-content: center;
            align-items: center;
            border-right: 1px solid #000;
        }

        .hecho-datos {
            flex: 2;
            padding: 2rem;
            color: white;
            background-color: rgba(108, 71, 27, 0.85);
        }

        .hecho-acciones {
            margin-top: 1.5rem;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .boton-solicitar {
            background-color: #b30000;
            color: white;
            border: none;
            padding: 0.6rem 1.2rem;
            border-radius: 5px;
            cursor: pointer;
        }

        .boton-solicitar:hover {
            background-color: #800000;
        }
        
        .boton-modificacion {
            background-color: #ffc107;
            color: #212529;
        }
        
        .boton-modificacion:hover {
            background-color: #e0a800;
        }

        .hecho-flechas {
            position: static;
            width: 100%;
            padding: 10px 0;
            display: flex;
            justify-content: center;
            gap: 20px;
            background: rgba(108, 71, 27, 0.85);
            border-radius: 0 0 8px 8px; 
            box-shadow: 0 5px 5px rgba(0, 0, 0, 0.1) inset;
        }

        .hecho-flechas .flecha {
            text-decoration: none;
            font-size: 1.5rem;
            color: #fff;
            background-color: rgba(0, 0, 0, 0.2);
            border-radius: 4px;
            width: 30px;
            height: 30px;
            line-height: 30px;
            text-align: center;
            cursor: pointer;
            transition: opacity 0.3s, background-color 0.3s;
            margin: 0 !important;
        }

        .hecho-flechas .flecha:hover {
            background-color: rgba(0, 0, 0, 0.4);
        }

        .hecho-sin-multimedia .hecho-flechas {
            display: none;
        }

        .hecho-datos::after {
            content: none !important;
        }
        
        .imagen-principal {
            max-width: 100%;
            max-height: 100%;
            width: auto;
            height: auto;
            object-fit: contain;
            display: block;
        }
        
        #contenedorMultimedia {
            min-height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 0, 0, 0.1);
            border: 2px solid red;
        }


    </style>
</head>
<body>

{{#if successMessage}}
<div class="alert alert-success" style="background-color: #d4edda; color: #155724; padding: 15px; margin: 20px; border: 1px solid #c3e6cb; border-radius: 5px; text-align: center; position: relative;">
    <button onclick="this.parentElement.style.display='none'" style="position: absolute; top: 10px; right: 15px; background: none; border: none; font-size: 18px; cursor: pointer; color: #155724;">&times;</button>
    {{successMessage}}
</div>
{{/if}}

{{#if errorMessage}}
<div class="alert alert-error" style="background-color: #f8d7da; color: #721c24; padding: 15px; margin: 20px; border: 1px solid #f5c6cb; border-radius: 5px; text-align: center; position: relative;">
    <button onclick="this.parentElement.style.display='none'" style="position: absolute; top: 10px; right: 15px; background: none; border: none; font-size: 18px; cursor: pointer; color: #721c24;">&times;</button>
    {{errorMessage}}
</div>
{{/if}}

<main class="hecho-main">
    <div id="hechoContenedor" class="hecho-contenedor">

        <div class="hecho-contenido-superior">
            <div class="hecho-imagen" id="contenedorMultimedia"></div>

            <div class="hecho-datos">
                <h1>{{hecho.titulo}}</h1>

                <p><strong>Categoría:</strong> {{hecho.categoria}}</p>
                <p><strong>Descripción:</strong> {{hecho.descripcion}}</p>
                <p><strong>Estado:</strong> {{hecho.estadoHecho}}</p>
                <p><strong>Fecha del hecho:</strong> {{hecho.fechaAcontecimiento}}</p>
                <p><strong>Origen:</strong> {{hecho.origenHecho}}</p>

                <div class="hecho-acciones">
                    <button type="button" class="boton-solicitar" onclick="solicitarEliminacion()">Solicitar Eliminación</button>
                    {{#if loggedIn}}
                    <button type="button" class="boton-solicitar boton-modificacion" onclick="solicitarModificacion()">Solicitar Modificación</button>
                    {{/if}}
                </div>
            </div>
        </div>
        <div class="hecho-flechas">
            <a href="#" id="flechaAnterior" class="flecha">⬅</a>
            <a href="#" id="flechaSiguiente" class="flecha">➡</a>
        </div>


    </div>
</main>

<script>
    const urlsMultimedia = [
        {{#each hecho.contenidoMultimedia}}
            "{{this.urlArchivo}}"{{#unless @last}},{{/unless}}
        {{/each}}
    ];

    const tiposMultimedia = [
        {{#each hecho.contenidoMultimedia}}
            "{{this.tipoContenido}}"{{#unless @last}},{{/unless}}
        {{/each}}
    ];

    const contenedor = document.getElementById('contenedorMultimedia');
    const contenedorPrincipal = document.getElementById('hechoContenedor');
    const flechaAnterior = document.getElementById('flechaAnterior');
    const flechaSiguiente = document.getElementById('flechaSiguiente');
    let indiceActual = 0;

    function actualizarFlechas() {
        flechaAnterior.style.opacity = (indiceActual === 0) ? 0.5 : 1;
        flechaSiguiente.style.opacity = (indiceActual === urlsMultimedia.length - 1) ? 0.5 : 1;
    }

    function renderizarContenido() {
        const tipo = tiposMultimedia[indiceActual];
        const url = urlsMultimedia[indiceActual];

        if(tipo === "VIDEO") {
            contenedor.innerHTML = `
                <video id="imagenPrincipal" class="imagen-principal" controls preload="metadata">
                    <source src="${url}" type="video/mp4">
                    Tu navegador no soporta videos.
                </video>
            `;
        } else {
            contenedor.innerHTML = `
                <img id="imagenPrincipal" src="${url}" class="imagen-principal">
            `;
        }
        actualizarFlechas();
    }
    flechaSiguiente.addEventListener('click', e => {
        e.preventDefault();
        if(indiceActual < urlsMultimedia.length - 1){
            indiceActual++;
            renderizarContenido();
        }
    });

    flechaAnterior.addEventListener('click', e => {
        e.preventDefault();
        if(indiceActual > 0){
            indiceActual--;
            renderizarContenido();
        }
    });

    if(urlsMultimedia.length > 0){
        renderizarContenido();
        if(urlsMultimedia.length === 1){
            flechaAnterior.style.display = 'none';
            flechaSiguiente.style.display = 'none';
        }
    } else {
        contenedor.innerHTML = '<div style="color: white; text-align: center; padding: 50px;">Sin contenido multimedia</div>';
        contenedorPrincipal.classList.add("hecho-sin-multimedia");
        flechaAnterior.style.display = 'none';
        flechaSiguiente.style.display = 'none';
    }
    
    // Obtener IDs de parámetros URL o del hecho
    const urlParams = new URLSearchParams(window.location.search);
    const hechoIdFromUrl = urlParams.get('id');
    const hechoId = hechoIdFromUrl || {{hecho.id}};
    const coleccionId = {{#if hecho.coleccion.id}}{{hecho.coleccion.id}}{{else}}1{{/if}};
    
    function solicitarEliminacion() {
        window.location.href = `/solicitudes?tipo=eliminacion&hechoId=${hechoId}&coleccionId=${coleccionId}`;
    }
    
    function solicitarModificacion() {
        window.location.href = `/solicitudes?tipo=modificacion&hechoId=${hechoId}&coleccionId=${coleccionId}`;
    }
</script>

</body>
</html>