<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>{{title}}</title>
    <link rel="stylesheet" href="/static/css/style_estadisticas.css">
</head>
<div class="container mt-4">
    <h1 class="mb-4 text-center">
    Resultados de Estadísticas
    </h1>

    <form method="post" action="/estadisticas/descargar">
        <div class="card p-4 shadow-sm">

            {{#if estadisticas}}
        <table class="table align-middle">
        <thead>
        <tr>
        <th></th>
        <th>Descripción</th>
        <th>Fecha de cálculo</th>
        </tr>
        </thead>
        <tbody>
        {{#each estadisticas}}
        <tr>
        <td>
            <input type="checkbox" class="form-check-input" name="seleccionadas" value="{{id}}">
        </td>
        <td><strong>{{respuesta}}</strong></td>
        <td><small>{{fechaDeCalculo}}</small></td>
        </tr>
        {{/each}}
        </tbody>
        </table>

<div class="text-center mt-3">
<button type="submit" class="btn btn-primary">
Descargar seleccionadas en CSV
</button>
</div>

{{else}}

<p class="text-center text-muted fs-5">No hay estadísticas disponibles.</p>

{{/if}}

</div>
</form>
</div>
<style>
    .form-actions {
        display: flex; justify-content: space-between; align-items: center; margin-top: 20px;
    }
    .btn-link {
        color: #007bff; text-decoration: none; font-size: 16px;
    }
    .btn-link:hover {
        text-decoration: underline; color: #0056b3;
    }
    .btn-submit { background-color: #28a745;
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.3s;
    }
    .btn-submit:hover {
        background-color: #218838;
    }
</style>

