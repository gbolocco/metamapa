
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Estadísticas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light p-4">

<div class="container">
    <h1 class="mb-4">Resultados de Estadísticas</h1>

    <form method="post" action="/estadisticas/descargar">
        <div class="card p-3 shadow-sm">
            {{#if estadisticas}}
                <ul class="list-group mb-3">
                    {{#each estadisticas}}
                        <li class="list-group-item d-flex align-items-center">
                            <input type="checkbox" class="form-check-input me-2" name="seleccionadas" value="{{this}}">
                            <span>{{this}}</span>
                        </li>
                    {{/each}}
                </ul>
                <button type="submit" class="btn btn-primary">
                    Descargar seleccionadas en CSV
                </button>
            {{else}}
                <p>No hay estadísticas disponibles.</p>
            {{/if}}
        </div>
    </form>
</div>

</body>
</html>
