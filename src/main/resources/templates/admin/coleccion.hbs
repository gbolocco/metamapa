<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <title>Crear Colección</title>
    <link rel="stylesheet" href="/static/css/style_coleccion_admin.css">
</head>
<body>
<div class="form-container">
    <h1>Crear nueva Colección</h1>

    <form method="post" action="/colecciones" id="formColeccion">
        <div class="form-group">
            <label for="titulo">Título:</label>
            <input type="text" id="titulo" name="titulo" required>
        </div>

        <div class="form-group">
            <label for="descripcion">Descripción:</label>
            <textarea id="descripcion" name="descripcion" rows="3" required></textarea>
        </div>

        <hr>

        <div class="form-group">
            <label for="consenso">Algoritmo de consenso:</label>
            <select id="consenso" name="consenso" required>
                <option value="">Seleccionar...</option>
                <option value="ABSOLUTA">Absoluta</option>
                <option value="MULTIPLES_MENCIONES">Múltiples menciones</option>
                <option value="MAYORIA_SIMPLE">Mayoría simple</option>
            </select>
        </div>

        <div class="form-group">
            <label for="fuentes">Seleccionar fuentes:</label>

            <div class="dropdown-container">
                <button type="button" id="dropdownBtn" class="dropdown-btn">Agregar fuente ▼</button>
                <div id="dropdownList" class="dropdown-list hidden">
                    {{#each fuentes}}
                        <div class="dropdown-item" data-id="{{this.id}}">{{this.id}}</div>
                    {{/each}}
                </div>
            </div>

            <div id="fuentesSeleccionadas" class="chips-container"></div>
            <input type="hidden" name="fuentesSeleccionadas" id="fuentesSeleccionadasInput">
        </div>


        <h2>Criterio de pertenencia</h2>
        <div id="filtros-container"></div>
        <button type="button" id="agregarFiltro" class="btn-secondary">Agregar Filtro</button>

        <div class="form-actions">
            <button type="submit">Guardar Colección</button>
            <a href="/" class="btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

<script>
    const filtrosContainer = document.getElementById("filtros-container");
    const btnAgregarFiltro = document.getElementById("agregarFiltro");
    // Contador para asegurar nombres de filtros únicos
    let filtroCount = 0;

    btnAgregarFiltro.addEventListener("click", () => {
        const filtroDiv = document.createElement("div");
        filtroDiv.classList.add("filtro-item");

        // Usar el contador para el name attribute (filtros[0][...], filtros[1][...], etc.)
        const index = filtroCount++;

        filtroDiv.innerHTML = `
      <div class="form-group">
        <label>Tipo de filtro:</label>
        <select name="filtros[${index}][tipo]" class="tipo-filtro">
          <option value="texto">Texto contiene</option>
          <option value="fechaDesde">Fecha desde</option>
          <option value="fechaHasta">Fecha hasta</option>
        </select>
      </div>

      <div class="form-group">
        <label>Campo:</label>
        <select name="filtros[${index}][campo]" class="campo-filtro">
          <option value="titulo">Título</option>
          <option value="descripcion">Descripción</option>
          <option value="fechaAcontecimiento">Fecha de acontecimiento</option>
        </select>
      </div>

      <div class="form-group">
        <label>Valor:</label>
        <input type="text" name="filtros[${index}][valor]" class="valor-filtro" placeholder="Ingrese valor...">
      </div>

      <button type="button" class="btn-eliminar">Eliminar</button>
    `;

        filtroDiv.querySelector(".btn-eliminar").addEventListener("click", () => {
            filtroDiv.remove();
        });

        filtrosContainer.appendChild(filtroDiv);
    });
</script>

<script>
    const dropdownBtn = document.getElementById("dropdownBtn");
    const dropdownList = document.getElementById("dropdownList");
    const contenedorChips = document.getElementById("fuentesSeleccionadas");
    const inputHidden = document.getElementById("fuentesSeleccionadasInput");

    let seleccionadas = [];

    // Lógica del Dropdown
    dropdownBtn.addEventListener("click", () => {
        dropdownList.classList.toggle("hidden");
    });

    dropdownList.addEventListener("click", (e) => {
        if (!e.target.classList.contains("dropdown-item")) return;
        const id = e.target.dataset.id;

        if (!seleccionadas.includes(id)) {
            seleccionadas.push(id);
            actualizarChips();
        }
    });

    // Lógica de Chips
    function actualizarChips() {
        contenedorChips.innerHTML = "";
        seleccionadas.forEach(id => {
            const chip = document.createElement("div");
            chip.className = "chip";
            chip.innerHTML = `${id} <span data-id="${id}">×</span>`;
            contenedorChips.appendChild(chip);
        });
        inputHidden.value = seleccionadas.join(",");
    }

    contenedorChips.addEventListener("click", (e) => {
        if (e.target.tagName === "SPAN") {
            const id = e.target.dataset.id;
            seleccionadas = seleccionadas.filter(f => f !== id);
            actualizarChips();
        }
    });

    // Cerrar el dropdown al hacer clic fuera
    document.addEventListener("click", (e) => {
        if (!dropdownBtn.contains(e.target) && !dropdownList.contains(e.target)) {
            dropdownList.classList.add("hidden");
        }
    });
</script>
</body>
</html>