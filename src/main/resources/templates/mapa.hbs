<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>{{title}}</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
</head>
<div> <h1>Mapa de Hechos</h1> </div>
<div id="map"></div>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script>
    // Los datos vienen del backend como un JSON string
    const hechos = {{hechosJson}};

    // Crear el mapa centrado en Buenos Aires (ajustá el zoom si tus puntos están lejos)
    const map = L.map('map').setView([-34.6037, -58.3816], 5);

    // Capa base (OpenStreetMap)
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    // Añadir los marcadores
    hechos.forEach(h => {
        const marker = L.marker([h.ubicacion.latitud, h.ubicacion.longitud])
                .addTo(map)
                .bindPopup(`
      <b>${h.titulo}</b><br>
      ${h.descripcion}<br>
      (${h.ubicacion.latitud}, ${h.ubicacion.longitud})<br>

    `);
    });



</script>
