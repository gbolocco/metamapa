<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <title>Crear nueva Fuente</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
<div class="container py-5">
    <div class="card shadow-sm p-4 mx-auto" style="max-width: 600px;">
        <h2 class="text-center text-primary mb-4">Crear nueva Fuente</h2>

        <form method="post" action="/fuentes" enctype="multipart/form-data">

            <!-- Nombre -->
            <div class="mb-3">
                <label for="nombre" class="form-label">Nombre:</label>
                <input type="text" id="nombre" name="nombre" class="form-control" required>
            </div>

            <!-- Descripción -->
            <div class="mb-3">
                <label for="descripcion" class="form-label">Descripción:</label>
                <textarea id="descripcion" name="descripcion" class="form-control" rows="3"></textarea>
            </div>

            <!-- Tipo de fuente -->
            <div class="mb-3">
                <label for="tipo" class="form-label">Tipo de fuente:</label>
                <select id="tipo" name="tipo" class="form-select" required>
                    <option value="">Seleccionar...</option>
                    <option value="estatica">Estática (CSV)</option>
                    <option value="proxy">Proxy (URL)</option>
                </select>
            </div>

            <!-- Fuente estática (archivo CSV) -->
            <div class="mb-3" id="campo-csv" style="display: none;">
                <label for="archivo" class="form-label">Archivo CSV:</label>
                <input type="file" id="archivo" name="archivo" accept=".csv" class="form-control">
            </div>

            <!-- Fuente proxy (URL) -->
            <div class="mb-3" id="campo-url" style="display: none;">
                <label for="url" class="form-label">URL del proxy:</label>
                <input type="url" id="url" name="url" class="form-control" placeholder="https://ejemplo.com/api/datos">
            </div>

            <!-- Botones -->
            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary me-2">Guardar Fuente</button>
                <a href="/fuentes" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<script>
    // Mostrar/ocultar campos según el tipo de fuente
    const tipoSelect = document.getElementById('tipo');
    const campoCsv = document.getElementById('campo-csv');
    const campoUrl = document.getElementById('campo-url');

    tipoSelect.addEventListener('change', () => {
        const tipo = tipoSelect.value;
        campoCsv.style.display = tipo === 'estatica' ? 'block' : 'none';
        campoUrl.style.display = tipo === 'proxy' ? 'block' : 'none';
    });
</script>
</body>
</html>
