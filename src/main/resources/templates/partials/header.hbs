<header class="site-header">
  <div class="header-inner">

    <!-- Logo -->
    <a href="/home" class="logo"></a>

    <!-- Nav -->
    <nav class="main-nav" aria-label="Principal">
      <a href="/colecciones">Navegar Colecciones</a>
      <a href="/hechos/nuevo">Subí tu Hecho</a>
      <a href="/mis-hechos" id="misHechos" style="display: none;">Mis Hechos</a>
      <a href="/mis-solicitudes" id="misSolicitudes" style="display: none;">Mis Solicitudes</a>
    </nav>

    <!-- Menu -->
    <div class="login-dropdown">
      <button class="profile-btn" title="Menu" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M20.59 22C20.59 18.13 16.74 15 12 15C7.26 15 3.41 18.13 3.41 22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
        <div class="dropdown-menu">
            {{#if loggedIn}}
                <div class="dropdown-item" id="dropDown-options"></div>
            {{else}}
                <a href="/login" class="btn">Iniciar Sesión</a>
            {{/if}}
        </div>
    </div>


  </div>
</header>

<script>
    const tipoUsuario = "{{rol}}";
    const nombreUsuario = "{{user_name}}";
    const estaLogueado = "{{loggedIn}}" === "true";

    const menu = document.getElementById("dropDown-options");
    const misSolicitudes = document.getElementById("misSolicitudes");
    const misHechos = document.getElementById("misHechos");

    if (estaLogueado && tipoUsuario === "USER") {
        if (misSolicitudes) {
            misSolicitudes.style.display = "inline";
        }
        if (misHechos) {
            misHechos.style.display = "inline";
        }
    }

    if (estaLogueado && menu) {
        let html = `<span class="user_name"><b>${nombreUsuario}</b></span>`;

        if (tipoUsuario === "ADMIN") {
            html += `
        <span><a href="/admin/dashboard">Panel admin</a></span>
        <form id="logoutForm" method="post" action="/logout">
          <button type="submit">Salir</button>
        </form>`;
        } else if (tipoUsuario === "USER") {
            html += `
        <span><a href="/solicitudes">Solicitudes</a></span>
        <form id="logoutForm" method="post" action="/logout">
          <button type="submit">Salir</button>
        </form>`;
        }

        menu.innerHTML = html;
    }
</script>
