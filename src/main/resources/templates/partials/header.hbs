<header class="site-header">
    <div class="header-inner">

        <!-- Logo -->
        <a href="/home" class="logo"></a>

        <!-- Nav -->
        <nav class="main-nav" aria-label="Principal">
            <a href="/colecciones" class="colecciones-nav">Navegar Colecciones</a>
            <a href="/hechos/nuevo" class="nuevo-hecho-nav">Subí tu Hecho</a>
            <a href="/estadisticas" id="estadisticas" class="estadisticas-nav">Estadisticas</a>
        </nav>

        <!-- Menu -->
        <div class="login-dropdown">
            <button class="profile-btn" title="Menu" aria-label="Menu">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path
                        d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12Z"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M20.59 22C20.59 18.13 16.74 15 12 15C7.26 15 3.41 18.13 3.41 22" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
            <div class="dropdown-menu" id="dropDown-options">
                {{#if loggedIn}}
                {{else}}
                <a href="/login" class="dropdown-item login-btn">
                    Iniciar Sesión
                </a>
                {{/if}}
            </div>
        </div>


    </div>
</header>

<script>
    const tipoUsuario = "{{rol}}";
    const nombreUsuario = "{{user_name}}";
    const estaLogueado = "{{loggedIn}}" === "true";
    const loginDropdown = document.querySelector('.login-dropdown');

    const menu = document.getElementById("dropDown-options");
    const misSolicitudes = document.getElementById("misSolicitudes");
    const misHechos = document.getElementById("misHechos");

    console.log("Debug Header: Logueado:", estaLogueado, "Rol:", tipoUsuario);

    if (estaLogueado) {
        if (misSolicitudes && (tipoUsuario === "USER" || tipoUsuario === "ADMIN")) {
            misSolicitudes.style.display = "inline";
        }
        if (misHechos && (tipoUsuario === "USER" || tipoUsuario === "ADMIN")) {
            misHechos.style.display = "inline";
        }
    }

    if (loginDropdown && (tipoUsuario !== "ADMIN")) {
        loginDropdown.classList.add('user-spacing');
    }

    if (estaLogueado && menu) {
        let html = `<span class="user_name">${nombreUsuario}</span>
            <hr style="margin: 4px 0; border: none; border-top: 1px dashed #e0e0e0;">`;

        // Icono para 'Panel admin' (Ejemplo: Cog o Dashboard)
        const adminIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M19 12h-2V7h-4V5h4V3h2v2h2v4h-2zm-4 6v-2h6v2h-6zM3 3v2h6V3H3zm0 4v2h10V7H3zm0 4v2h6v-2H3zm0 4v2h10v-2H3zm0 4v2h6v-2H3z"/></svg>';
        // Icono para 'Solicitudes' (Ejemplo: File/Documento)
        const solicitudIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>';
        // Icono para 'Salir/Logout' (Ejemplo: Exit/Puerta)
        const salirIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M16 9v-4l8 7-8 7v-4h-8v-6h8zM14 19h-12v-14h12v-3h-14v20h14v-3z"/></svg>';
        const hechoIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 640 640"><path fill="currentColor" d="M480 576L192 576C139 576 96 533 96 480L96 160C96 107 139 64 192 64L496 64C522.5 64 544 85.5 544 112L544 400C544 420.9 530.6 438.7 512 445.3L512 512C529.7 512 544 526.3 544 544C544 561.7 529.7 576 512 576L480 576zM192 448C174.3 448 160 462.3 160 480C160 497.7 174.3 512 192 512L448 512L448 448L192 448zM224 216C224 229.3 234.7 240 248 240L424 240C437.3 240 448 229.3 448 216C448 202.7 437.3 192 424 192L248 192C234.7 192 224 202.7 224 216zM248 288C234.7 288 224 298.7 224 312C224 325.3 234.7 336 248 336L424 336C437.3 336 448 325.3 448 312C448 298.7 437.3 288 424 288L248 288z"/></svg>';

        if (tipoUsuario === "ADMIN") {
            html += `
        <a href="/admin/dashboard" class="dropdown-item">${adminIcon} Panel admin</a>
        <a href="/solicitudes" class="dropdown-item">${solicitudIcon} Solicitudes</a>
        <a href="/mis-hechos" class="dropdown-item">${hechoIcon} Mis Hechos</a>
        <form id="logoutForm" method="post" action="/logout">
          <button type="submit" class="dropdown-item">${salirIcon} Cerrar Sesión</button>
        </form>`;
        } else if (tipoUsuario === "USER") {
            html += `
        <a href="/solicitudes" class="dropdown-item">${solicitudIcon} Solicitudes</a>
        <a href="/mis-hechos" class="dropdown-item">${hechoIcon} Mis Hechos</a>
        <form id="logoutForm" method="post" action="/logout">
          <button type="submit" class="dropdown-item">${salirIcon} Cerrar Sesión</button>
        </form>`;
        }

        menu.innerHTML = html;
    }
</script>